{
  "manifest_version": 3,
  "name": "TabscrAIp",
  "version": "0.1.0",
  "description": "AI-powered web scraper that structures content into sortable, groupable tables",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon_scraper16.png",
      "48": "icons/icon_scraper48.png",
      "128": "icons/icon_scraper128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon_scraper16.png",
    "48": "icons/icon_scraper48.png",
    "128": "icons/icon_scraper128.png"
  }
}
